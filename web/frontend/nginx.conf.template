# Rendered at container start by the nginx image's envsubst entrypoint.
# Only ${BACKEND_UPSTREAM} is substituted — NGINX_ENVSUBST_FILTER in compose
# restricts it to that one name, so nginx's own $host / $uri / $remote_addr
# survive untouched.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Compress text assets. Vite already minifies; this is the transfer win.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed filenames from vite build are safe to cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, or users keep loading a stale bundle
    # that points at deleted asset hashes after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Same-origin API. Keeps the bundle free of any hardcoded backend host and
    # sidesteps CORS entirely — the browser only ever talks to this origin.
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # File uploads (documents, KYC) go through here.
        client_max_body_size 25m;
        proxy_read_timeout 120s;
    }

    # socket.io (WebRTC signalling) needs the connection upgraded to a websocket.
    location /socket.io/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }

    # SPA fallback: react-router owns every path that is not a real file.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
