# Compose-level settings. Copy to .env.docker and edit.
# Application secrets do NOT belong here — they stay in backend/.env.

# ── Host ports (all bound to 127.0.0.1 only) ────────────────────────────────
BACKEND_PORT=8002
BACKEND_PROD_PORT=8003
WEB_PORT=5173
WEB_PROD_PORT=8080
RAG_PORT=8100
MONGO_PORT=27017
REDIS_PORT=6379
MONGO_EXPRESS_PORT=8081
REDIS_INSIGHT_PORT=8001

# ── Image versions ──────────────────────────────────────────────────────────
MONGO_VERSION=7
REDIS_VERSION=7-alpine

# ── Redis ───────────────────────────────────────────────────────────────────
# Local container by default. To move to a managed instance later, set this to
# the provider's URL and stop the local one (`docker compose stop redis`) —
# nothing in the app code changes:
#   REDIS_URL=rediss://default:<password>@<host>:6379
REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=256mb
# noeviction: refuse writes when full rather than silently dropping keys. Switch
# to allkeys-lru only if Redis holds nothing but a disposable cache.
REDIS_MAXMEMORY_POLICY=noeviction

# ── Resource caps ───────────────────────────────────────────────────────────
MONGO_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m
RAG_MEMORY_LIMIT=2g

# ── AI / RAG ────────────────────────────────────────────────────────────────
# Ollama runs on the host, not in a container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_EMBED_MODEL=bge-m3
RAG_CHAT_MODEL=llama3.1:8b
AI_PROVIDER=ollama
# Set when the backend should talk to a RAG service you run outside compose.
# Under `make up-all` the rag container is used automatically.
# RAG_SERVICE_URL=http://host.docker.internal:8100

# ── Frontend ────────────────────────────────────────────────────────────────
# Set true if vite HMR stops noticing your edits (inotify over a bind mount).
WEB_POLLING=false

# ── Tools (basic auth for mongo-express) ────────────────────────────────────
ME_USER=admin
ME_PASSWORD=admin
