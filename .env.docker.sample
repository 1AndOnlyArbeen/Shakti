# Compose-level settings — copy to .env.docker to override.
# Application secrets do NOT belong here; they stay in backend/.env.

# Host ports (all bound to 127.0.0.1 only)
BACKEND_PORT=8002
BACKEND_PROD_PORT=8003
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# Image versions
MONGO_VERSION=7

# Resource caps
MONGO_MEMORY_LIMIT=1g

# mongo-express basic auth (tools profile)
ME_USER=admin
ME_PASSWORD=admin
